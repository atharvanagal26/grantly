{
  "name": "grantly",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "cross-env PORT=3001 NODE_ENV=development node --watch server/index.js",
    "dev:web": "vite --host 0.0.0.0 --port 3000 --strictPort",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test",
    "check": "node --check server/index.js && node --check src/utils/smartMatch.js && node --check src/data/scholarships.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "recharts": "^3.10.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "tailwindcss": "^4.1.11",
    "vite": "^6.0.7"
  }
}
