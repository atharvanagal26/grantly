# Optional public API base URL when the Vercel frontend is hosted separately from Express.
# Leave unset when frontend and API share one origin.
VITE_API_BASE_URL=

# Express runtime port. Manus Preview uses 3000; local Vite dev proxies to port 3001.
PORT=3000

# Optional comma-separated exact browser origins allowed to call the API cross-origin.
# Example: https://grantly.example.com
CORS_ORIGIN=
